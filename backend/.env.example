NODE_ENV=development
PORT=4000

# --- Database (MySQL 8) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_campaign_assistant
DB_USER=root
DB_PASSWORD=change_me
DB_LOGGING=false
# Dev convenience only: create tables via sequelize.sync(). Use migrations in production.
DB_SYNC=false

# --- JWT (use two different random 32+ char secrets; required in production) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=dme-ai-campaign-assistant
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- Refresh cookie ---
COOKIE_SAMESITE=strict          # strict | lax | none (none forces Secure)
COOKIE_SECURE=false             # always true automatically in production
COOKIE_DOMAIN=

# --- HTTP ---
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false               # set to 1 when behind a reverse proxy / load balancer

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
OPENAI_TIMEOUT_MS=30000

# --- Seeder ---
SEED_ADMIN_EMAIL=admin@dmesystems.com
SEED_ADMIN_PASSWORD=
